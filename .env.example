# =====================================================================
# RotaClara — variáveis de ambiente (exemplo)
# ---------------------------------------------------------------------
# Copie para `.env.local` e preencha apenas quando tiver os valores.
# NUNCA coloque valores reais neste arquivo nem no repositório.
# Todos os itens são OPCIONAIS na primeira versão: o site funciona
# sem nenhuma variável definida.
# =====================================================================

# --- Site -------------------------------------------------------------
# URL canônica usada em sitemap, canonical e Open Graph.
# Em produção na Vercel: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nome do site nos metadados.
NEXT_PUBLIC_SITE_NAME=RotaClara

# --- Google (opcionais) -----------------------------------------------
# Search Console: verificação por meta tag (deixe vazio se ainda não tiver).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 — measurement ID (formato G-XXXXXXX).
# Deixe vazio para não carregar nenhum script de análise.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Google AdSense — publisher ID (formato ca-pub-XXXXXXXXXXXXXXXX).
# Deixe vazio: nenhum anúncio é renderizado sem valor válido.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --- Monetização / afiliados (opcionais) -------------------------------
# Stay22 — identificador da conta (publisher / link ID).
# Documentação oficial: https://www.stay22.com/
# Sem valor, os componentes Stay22 renderizam o modo editorial (sem rastreio).
STAY22_PUBLISHER_ID=

# Booking.com — ID do programa de afiliados.
BOOKING_AFFILIATE_ID=

# GetYourGuide / Viator / Civitatis — IDs de parceiro.
GETYOURGUIDE_PARTNER_ID=
VIATOR_AFFILIATE_ID=
CIVITATIS_AFFILIATE_ID=

# --- Futuro (não utilizado na v1) -------------------------------------
# Provedor de clima, mapa ou IA. A camada de integração já existe,
# mas nada é chamado sem valor configurado.
WEATHER_API_KEY=
MAPS_API_KEY=
AI_API_KEY=
